{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gitquarry/schema/pipeline/v1/secret-ref.schema.json",
  "title": "SecretRef",
  "description": "A reference to a secret by name, never the secret's value. The only way a JobSpec can name a secret.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "env_key",
    "secret_name"
  ],
  "properties": {
    "env_key": {
      "type": "string"
    },
    "secret_name": {
      "type": "string"
    }
  }
}
